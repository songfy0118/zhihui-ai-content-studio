{
  "name": "zhihui-ai-content-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "local:serve": "vinext dev --hostname 127.0.0.1 --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run db:preflight && npm run secrets:check && npm run cosyvoice:plan:check && npm run cosyvoice:smoke:plan:check && node --test tests/rendered-html.test.mjs tests/news-source-catalog.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "local:doctor": "node scripts/check-local-runtime.mjs",
    "studio:build:check": "node scripts/check-studio-build.mjs",
    "bridge:restart:plan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/restart-local-bridge.ps1",
    "bridge:verify:parallel": "node scripts/verify-bridge-parallel.mjs",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "node scripts/check-review-migration.mjs",
    "db:local:plan": "node scripts/check-local-d1-migration-readiness.mjs",
    "db:local:chain:plan": "node scripts/plan-local-d1-chain.mjs",
    "db:local:chain:apply": "node scripts/apply-local-d1-chain.mjs",
    "db:local:chain:prepare": "node scripts/prepare-local-d1-execution.mjs",
    "db:chain:verify:isolated": "node scripts/verify-d1-chain-in-memory.mjs",
    "db:local:apply": "node scripts/apply-local-receipt-migration.mjs",
    "secrets:check": "node scripts/check-secret-boundary.mjs",
    "facts:sources:check": "node scripts/check-source-availability.mjs",
    "cosyvoice:plan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-cosyvoice.ps1",
    "cosyvoice:plan:check": "node scripts/check-cosyvoice-plan.mjs",
    "cosyvoice:smoke:plan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-cosyvoice-smoke.ps1",
    "cosyvoice:smoke:plan:check": "node scripts/check-cosyvoice-smoke-plan.mjs",
    "cosyvoice:smoke": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-cosyvoice-smoke.ps1 -Execute",
    "vendors:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-vendors.ps1",
    "pilot:import": "node scripts/import-pilot.mjs examples/octopus-pilot.json",
    "pilot:script-envelope": "node scripts/prepare-script-envelope.mjs",
    "pilot:script-plan": "node scripts/prepare-source-locked-script-plan.mjs",
    "pilot:package": "node scripts/build-delivery-package.mjs examples/octopus-pilot.json",
    "pilot:readiness": "node scripts/check-package-readiness.mjs",
    "pilot:sync": "node scripts/sync-local-artifacts.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
